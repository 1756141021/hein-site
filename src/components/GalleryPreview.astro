---
import SectionLabel from './SectionLabel.astro';

const images = [
  { src: '/images/hero/eyes-red-fox.png', pos: 'center 30%' },
  { src: '/images/hero/eyes-blue-maid.png', pos: 'center 25%' },
  { src: '/images/hero/eyes-silver-snow.png', pos: 'center 35%' },
  { src: '/images/hero/eyes-ice-twin.png', pos: 'center 30%' },
];
---

<section class="section" id="gallery-preview">
  <div class="container">
    <SectionLabel label="画廊" />
    <div class="gallery-row">
      {images.map((img, i) => (
        <a href="/gallery" class="gallery-thumb" style={`animation-delay: ${i * 80}ms`}>
          <img src={img.src} alt="" style={`object-position: ${img.pos}`} />
          <div class="gallery-thumb-overlay"></div>
        </a>
      ))}
    </div>
    <div class="gallery-cta">
      <a href="/gallery" class="gallery-link">查看全部作品 →</a>
    </div>
  </div>
</section>

<style>
  .gallery-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }

  .gallery-thumb {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 2px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    position: relative;
    display: block;
    transition: border-color 0.4s ease, transform 0.4s var(--ease-out-expo);
  }

  .gallery-thumb:hover {
    border-color: rgba(212, 165, 116, 0.25);
    transform: translateY(-3px);
  }

  .gallery-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s var(--ease-out-expo);
  }

  .gallery-thumb:hover img {
    transform: scale(1.04);
  }

  .gallery-thumb-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 10, 15, 0.4) 0%, transparent 50%);
    pointer-events: none;
  }

  .gallery-cta {
    text-align: center;
    margin-top: 1.5rem;
  }

  .gallery-link {
    font-size: 0.82rem;
    color: var(--accent);
    transition: color 0.3s ease;
  }

  .gallery-link:hover {
    color: var(--accent-hover);
  }

  @media (max-width: 640px) {
    .gallery-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
