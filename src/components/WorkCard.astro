---
interface Props {
  title: string;
  description: string;
  tags: string[];
  type?: 'code' | 'art' | 'writing';
  href?: string;
  thumbClass?: string;
}

const { title, description, tags, type = 'code', href = '#', thumbClass = '' } = Astro.props;

import TagPill from './TagPill.astro';
---

<a href={href} class:list={['work-card', `type-${type}`]}>
  <div class:list={['work-thumb', thumbClass]}>
    {type === 'writing' ? (
      <p class="work-excerpt">{description}</p>
    ) : (
      <div class="work-thumb-deco"></div>
    )}
  </div>
  <div class="work-body">
    <h3 class="work-title">{title}</h3>
    {type !== 'writing' && <p class="work-desc">{description}</p>}
    <div class="work-tags">
      {tags.map(tag => <TagPill tag={tag} />)}
    </div>
  </div>
</a>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line-subtle);
    border-radius: 2px;
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.4s ease, transform 0.4s var(--ease-out-expo), box-shadow 0.4s ease;
  }

  .work-card:hover {
    border-color: rgba(212, 165, 116, 0.2);
    transform: translateY(-4px);
    box-shadow: 0 8px 40px rgba(212, 165, 116, 0.06);
  }

  .work-thumb {
    aspect-ratio: 16 / 10;
    position: relative;
    overflow: hidden;
  }

  .type-code .work-thumb {
    background:
      linear-gradient(135deg, #12121A 0%, #1A1A28 100%),
      repeating-linear-gradient(0deg, transparent, transparent 24px, rgba(255,255,255,0.02) 24px, rgba(255,255,255,0.02) 25px),
      repeating-linear-gradient(90deg, transparent, transparent 24px, rgba(255,255,255,0.02) 24px, rgba(255,255,255,0.02) 25px);
  }

  .type-art .work-thumb {
    background: var(--surface-raised);
  }

  .type-writing .work-thumb {
    background: var(--surface);
    border-bottom: 1px solid var(--line-subtle);
    display: flex;
    align-items: center;
    padding: 1.5rem;
    border-left: 2px solid var(--accent);
  }

  .work-excerpt {
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--text-2);
    line-height: 1.8;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .work-thumb-deco {
    position: absolute;
    inset: 0;
    opacity: 0.3;
    transition: opacity 0.4s ease;
  }

  .work-card:hover .work-thumb-deco {
    opacity: 0.45;
  }

  /* geometric decorations for code projects */
  .thumb-circle .work-thumb-deco {
    border: 1px solid var(--accent);
    border-radius: 50%;
    width: 60%;
    height: 75%;
    margin: auto;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .thumb-cross .work-thumb-deco::before,
  .thumb-cross .work-thumb-deco::after {
    content: '';
    position: absolute;
    background: var(--accent);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
  .thumb-cross .work-thumb-deco::before { width: 1px; height: 50%; }
  .thumb-cross .work-thumb-deco::after { width: 50%; height: 1px; }

  .thumb-diamond .work-thumb-deco {
    width: 40%;
    height: 50%;
    border: 1px solid var(--accent);
    transform: translate(-50%, -50%) rotate(45deg);
    position: absolute;
    top: 50%;
    left: 50%;
  }

  .thumb-corners .work-thumb-deco::before,
  .thumb-corners .work-thumb-deco::after {
    content: '';
    position: absolute;
    width: 24px;
    height: 24px;
    border-color: var(--accent);
    border-style: solid;
  }
  .thumb-corners .work-thumb-deco::before {
    top: 16px; left: 16px;
    border-width: 1px 0 0 1px;
  }
  .thumb-corners .work-thumb-deco::after {
    bottom: 16px; right: 16px;
    border-width: 0 1px 1px 0;
  }

  .thumb-slash .work-thumb-deco::before {
    content: '';
    position: absolute;
    width: 120%;
    height: 1px;
    background: var(--accent);
    top: 50%;
    left: -10%;
    transform: rotate(-25deg);
  }

  .work-body {
    padding: 1rem 1.1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .work-title {
    font-family: var(--sans);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-1);
  }

  .work-desc {
    font-size: 0.78rem;
    color: var(--text-2);
    line-height: 1.6;
    text-wrap: pretty;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }
</style>
