---
interface Props {
  src: string;
  position?: string;
  height?: string;
}
const { src, position = 'center 40%', height = '140px' } = Astro.props;
---

<div class="artwork-strip" style={`height: ${height}`}>
  <img src={src} alt="" style={`object-position: ${position}`} />
  <div class="strip-fade-l"></div>
  <div class="strip-fade-r"></div>
  <div class="strip-fade-t"></div>
  <div class="strip-fade-b"></div>
  <div class="strip-border-top"></div>
  <div class="strip-border-bottom"></div>
</div>

<style>
  .artwork-strip {
    position: relative;
    width: 100%;
    overflow: hidden;
    opacity: 0.55;
    transition: opacity 0.6s ease;
  }

  .artwork-strip:hover {
    opacity: 0.75;
  }

  .artwork-strip img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .strip-fade-l,
  .strip-fade-r {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 20%;
    z-index: 1;
    pointer-events: none;
  }

  .strip-fade-l {
    left: 0;
    background: linear-gradient(to right, var(--bg) 0%, transparent 100%);
  }

  .strip-fade-r {
    right: 0;
    background: linear-gradient(to left, var(--bg) 0%, transparent 100%);
  }

  .strip-fade-t,
  .strip-fade-b {
    position: absolute;
    left: 0;
    right: 0;
    height: 30%;
    z-index: 1;
    pointer-events: none;
  }

  .strip-fade-t {
    top: 0;
    background: linear-gradient(to bottom, var(--bg) 0%, transparent 100%);
  }

  .strip-fade-b {
    bottom: 0;
    background: linear-gradient(to top, var(--bg) 0%, transparent 100%);
  }

  .strip-border-top,
  .strip-border-bottom {
    position: absolute;
    left: 20%;
    right: 20%;
    height: 1px;
    background: linear-gradient(to right, transparent 0%, rgba(212, 165, 116, 0.15) 30%, rgba(212, 165, 116, 0.15) 70%, transparent 100%);
    z-index: 2;
    pointer-events: none;
  }

  .strip-border-top { top: 0; }
  .strip-border-bottom { bottom: 0; }
</style>
